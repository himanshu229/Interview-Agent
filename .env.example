# ---------------------------------------------------------------------------
# AI Desktop Assistant - Environment configuration example
# Copy this file to `.env` and fill in your values.
#
# NOTE: The OpenAI API key is stored securely in the OS keychain at runtime.
# During development, VITE_OPENAI_API_KEY is imported into the keychain on
# startup when no key has been configured yet. Never commit a real `.env` file.
# ---------------------------------------------------------------------------

# OpenAI API key (development default; replace locally).
VITE_OPENAI_API_KEY=

# Default chat model.
VITE_OPENAI_MODEL=gpt-4o-mini

# Default Whisper transcription model.
VITE_WHISPER_MODEL=whisper-1

# OpenAI API base URL (override for Azure OpenAI or a proxy).
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Path to the tesseract executable (leave empty to use the one on PATH).
VITE_TESSERACT_PATH=

# Log level: trace | debug | info | warn | error
VITE_LOG_LEVEL=info
